generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabel Organisasi (Sekolah)
model Organization {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]   
  reports     Report[] // Relasi: 1 Sekolah punya banyak laporan
}

// Tabel Pengguna (Guru / Siswa)
model User {
  id             Int           @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String        @unique
  password       String        
  role           String        @default("siswa") 
  profileImage   String?
  organizationId Int?          
  organization   Organization? @relation(fields: [organizationId], references: [id])
  reports        Report[]      // Relasi: 1 User bisa buat banyak laporan
}

// Tabel Laporan (BARU)
model Report {
  id             Int          @id @default(autoincrement())
  type           String       // "Fasilitas Rusak" atau "Kebersihan"
  category       String
  location       String
  description    String
  photoBase64    String?      // Kita simpan foto dalam format Base64 Text agar mudah
  latitude       Float?
  longitude      Float?
  status         String       @default("Dilaporkan") // Status: Dilaporkan, Proses, Selesai
  createdAt      DateTime     @default(now())

  authorId       Int
  author         User         @relation(fields: [authorId], references:[id])

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references:[id])
}